# ---------------------------------------------------------------------------
# Root environment file used by docker-compose (`env_file: .env`).
# Copy to `.env` and fill in real values: `cp .env.example .env`
#
# Generate the secrets with:
#   ACCESS_SECRET / REFRESH_SECRET : openssl rand -hex 32
#   ENCRYPTION_KEY                 : openssl rand -hex 32   (must be 64 hex chars)
# ---------------------------------------------------------------------------

# --- Images & ports ---------------------------------------------------------
# Local builds use the defaults. To run CI-published images instead, set
# IMAGE_PREFIX to your Docker Hub username and IMAGE_TAG to the pushed tag.
IMAGE_PREFIX=automatekit
IMAGE_TAG=local
WEB_PORT=3000
SERVER_PORT=8000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=automatekit
POSTGRES_PASSWORD=
POSTGRES_DB=automatekit

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=

# --- Connection strings (hostnames match the compose service names) ---------
DATABASE_URL=postgresql://automatekit:${POSTGRES_PASSWORD}@postgres:5432/automatekit
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- Server -----------------------------------------------------------------
NODE_ENV=production
PORT=8000

# Public URLs. APP_URL is the CORS origin and OAuth postMessage target, so it
# must exactly match the origin the browser loads the dashboard from.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Must be >= 32 characters each, and different from one another.
ACCESS_SECRET=
REFRESH_SECRET=

# Exactly 64 hex characters (32 bytes) — used to encrypt stored OAuth tokens.
# Rotating this value makes existing stored connections undecryptable.
ENCRYPTION_KEY=

# Bounded per-service Postgres pool size.
DATABASE_POOL_MAX=10

# --- Executor ---------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Google Sign-In (login with Google) -------------------------------------
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Google / Gmail integration (workflow connections) ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/credential/gmail/callback

# --- Outbound email (password reset) ----------------------------------------
MAIL_USER=
MAIL_PASS=

# --- Web build-time vars (baked into the bundle by Vite) --------------------
# VITE_API_BASE_URL is the API origin only; the client appends `/api/v1` itself.
VITE_APP_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
