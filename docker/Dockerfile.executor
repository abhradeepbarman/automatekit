# ---- build stage -------------------------------------------------------------
FROM node:20-alpine AS builder

RUN npm install -g pnpm

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml turbo.json package.json .npmrc ./
COPY apps/executor ./apps/executor
COPY packages ./packages

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=executor

# Drop dev dependencies (typescript, tsx, drizzle-kit, ...) so they are not
# carried into the runtime image.
RUN pnpm prune --prod

# ---- runtime stage -----------------------------------------------------------
FROM node:20-alpine AS runner

ENV NODE_ENV=production

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/executor/dist ./apps/executor/dist
COPY --from=builder /app/apps/executor/node_modules ./apps/executor/node_modules
COPY --from=builder /app/apps/executor/package.json ./apps/executor/package.json

# Run unprivileged: the `node` user ships with the base image.
USER node

WORKDIR /app/apps/executor

# `dumb-init`-less SIGTERM handling: node is PID 1 here and the app installs its
# own SIGTERM handler for graceful worker shutdown (see src/index.ts).
CMD ["node", "dist/index.js"]
